{
  "name": "frog-network-spike",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "dev:server": "node --import tsx server/index.ts",
    "start": "node server-dist/index.js",
    "test:network": "node --import tsx scripts/network-tests.ts",
    "stress": "node --import tsx scripts/stress.ts",
    "test:browser": "node scripts/browser-check.cjs",
    "test:lifecycle": "node --import tsx scripts/lifecycle-tests.ts",
    "test:outbreak": "node --import tsx scripts/outbreak-tests.ts",
    "test:outbreak-browser": "node scripts/outbreak-browser.cjs",
    "test:mobile": "node scripts/mobile-browser.cjs",
    "test:compat": "node scripts/compat-browser.cjs",
    "test:presentation": "node scripts/presentation-browser.cjs",
    "test:mobile-recovery": "node scripts/mobile-recovery-browser.cjs",
    "test:arenas": "node --import tsx scripts/arena-network-tests.ts",
    "test:onboarding": "node scripts/onboarding-browser.cjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/ws-transport": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "express": "^4.22.3",
    "phaser": "3.90.0",
    "planck": "1.4.2"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^133.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.58.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
